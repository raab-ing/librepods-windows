[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%ProviderName%
DriverVer=04/11/2026,1.0.0.0
CatalogFile=librepods-kmdf.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
librepods-kmdf.sys=1

[Manufacturer]
%ProviderName%=Standard,NTamd64.10.0

[Standard.NTamd64.10.0]
%ProfileDeviceName%=LibrePods_Profile_Install,BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2014
%ProfileDeviceName%=LibrePods_Profile_Install,BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}
%ProfileDeviceName%=LibrePods_Profile_Install,BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_GENERIC
%ProfileDeviceName%=LibrePods_Profile_Install,BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2014
%ProfileDeviceName%=LibrePods_Profile_Install,BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}
%ProfileDeviceName%=LibrePods_Profile_Install,BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_GENERIC

[LibrePods_Profile_Install.NT]
CopyFiles=DriverCopyFiles
AddReg=LibrePods_Device_AddReg

[LibrePods_Profile_Install.NT.Interfaces]
AddInterface={3E98D13A-B2A5-4C3D-AE1E-8DB4F3D8C1F0},,"LibrePods_Interface"

[LibrePods_Interface]
AddReg=LibrePods_Interface_AddReg

[LibrePods_Interface_AddReg]
HKR,,FriendlyName,,%ProfileDeviceName%

[LibrePods_Device_AddReg]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;BU)"
HKR,,DeviceCharacteristics,0x10001,0x00000100
HKR,,DeviceType,0x10001,0x00000022

[DriverCopyFiles]
librepods-kmdf.sys

[LibrePods_Profile_Install.NT.Services]
AddService=librepods-kmdf,0x00000002,LibrePods_Service_Install

[LibrePods_Service_Install]
DisplayName=%ServiceDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\librepods-kmdf.sys

[LibrePods_Profile_Install.NT.Wdf]
KmdfService=librepods-kmdf,LibrePods_Wdf_Section

[LibrePods_Wdf_Section]
KmdfLibraryVersion=1.33

[Strings]
ProviderName="LibrePods"
ProfileDeviceName="LibrePods AirPods Control Profile"
ServiceDisplayName="LibrePods AirPods Control Profile"
DiskName="LibrePods Driver Package"
